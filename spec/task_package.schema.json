{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from vtf.core by `uv run python -m vtf.core.schemas`. Format version 0.2.0.",
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "description": "One gate's verdict. Serialised as {\"pass\": bool, \"evidence\": {...}}.",
      "properties": {
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "pass"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "One scene object as the scorer sees it: the words that can name it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Full name: [size] [colour] category.",
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "color_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Name"
        },
        "size_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Word"
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ProgramRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Registered program name, e.g. count_color.",
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "JSON-safe parameters.",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProgramRef",
      "type": "object"
    },
    "Versions": {
      "additionalProperties": false,
      "properties": {
        "vtf": {
          "title": "Vtf",
          "type": "string"
        },
        "spec": {
          "description": "SceneSpec version.",
          "title": "Spec",
          "type": "string"
        },
        "task": {
          "default": "0.2.0",
          "title": "Task",
          "type": "string"
        },
        "generator": {
          "description": "Sampler version.",
          "title": "Generator",
          "type": "string"
        },
        "programs": {
          "description": "Question-program version.",
          "title": "Programs",
          "type": "string"
        },
        "renderer": {
          "description": "Renderer and version, e.g. blender 5.3.0.",
          "title": "Renderer",
          "type": "string"
        }
      },
      "required": [
        "vtf",
        "spec",
        "generator",
        "programs",
        "renderer"
      ],
      "title": "Versions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_version": {
      "default": "0.2.0",
      "title": "Task Version",
      "type": "string"
    },
    "task_id": {
      "description": "Content hash of the task's inputs and answer.",
      "title": "Task Id",
      "type": "string"
    },
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "scene_hash": {
      "description": "sha256 of the settled scene file's canonical JSON.",
      "title": "Scene Hash",
      "type": "string"
    },
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "rig": {
      "default": "front",
      "description": "front, overhead or gripper.",
      "title": "Rig",
      "type": "string"
    },
    "image": {
      "default": "image.png",
      "description": "Path relative to the task folder.",
      "title": "Image",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "question_alt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The other phrasing (prompt-sensitivity subset).",
      "title": "Question Alt"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "template_id": {
      "title": "Template Id",
      "type": "string"
    },
    "program": {
      "$ref": "#/$defs/ProgramRef"
    },
    "answer": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Answer"
    },
    "answer_type": {
      "enum": [
        "int",
        "object",
        "set",
        "bool",
        "number"
      ],
      "title": "Answer Type",
      "type": "string"
    },
    "answer_text": {
      "title": "Answer Text",
      "type": "string"
    },
    "tolerance": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None means exact match.",
      "title": "Tolerance"
    },
    "shortcut_conflict": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Spatial families: True when a 2D-proximity heuristic gives a different answer from the 3D truth. Also in `difficulty`. None for non-spatial families.",
      "title": "Shortcut Conflict"
    },
    "shortcut_answer": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shortcut Answer"
    },
    "evidence_object_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Object Ids",
      "type": "array"
    },
    "scene_objects": {
      "description": "Every object in the scene with its naming words, so the scorer can resolve a free-text answer to exactly one object (never shown to the model).",
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Scene Objects",
      "type": "array"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/GateResult"
      },
      "description": "Gate id (G1, G3, G7, ...) -> result.",
      "title": "Gates",
      "type": "object"
    },
    "twin_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "On a twin task: the task id of the original.",
      "title": "Twin Of"
    },
    "twin_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "On an original with a G6 twin: the twin's task id.",
      "title": "Twin Id"
    },
    "difficulty": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Difficulty",
      "type": "object"
    },
    "seed": {
      "description": "Per-scene seed.",
      "title": "Seed",
      "type": "integer"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "required": [
    "task_id",
    "scene_id",
    "scene_hash",
    "camera_id",
    "question",
    "family",
    "template_id",
    "program",
    "answer",
    "answer_type",
    "answer_text",
    "evidence_object_ids",
    "gates",
    "seed",
    "versions"
  ],
  "title": "TaskPackage",
  "type": "object"
}
