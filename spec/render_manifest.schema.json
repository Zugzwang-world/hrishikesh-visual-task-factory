        "depth": {
          "description": "Relative path to depth.npy (float32, metres).",
          "title": "Depth",
          "type": "string"
        },
        "depth_kind": {
          "const": "planar_z",
          "default": "planar_z",
          "description": "Depth is camera-frame z (along the optical axis).",
          "title": "Depth Kind",
          "type": "string"
        },
        "amodal": {
