      "type": "string"
    },
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "scene_file": {
      "description": "Path of the input scene file as given to the renderer.",
      "title": "Scene File",
      "type": "string"
    },
    "scene_sha256": {
      "description": "sha256 of the input scene file's bytes.",
      "title": "Scene Sha256",
      "type": "string"
    },
    "settled_scene_file": {
      "default": "scene.settled.json",
      "title": "Settled Scene File",
      "type": "string"
    },
    "renderer": {
      "default": "blender",
      "description": "blender, or fixture for test data.",
      "title": "Renderer",
      "type": "string"
    },
    "blender_version": {
      "title": "Blender Version",
      "type": "string"
    },
    "device": {
      "description": "Device actually used.",
      "enum": [
        "GPU",
        "CPU"
      ],
      "title": "Device",
      "type": "string"
    },
    "device_name": {
      "default": "",
      "title": "Device Name",
      "type": "string"
    },
    "samples": {
      "title": "Samples",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "denoise": {
      "title": "Denoise",
      "type": "boolean"
    },
    "cameras": {
