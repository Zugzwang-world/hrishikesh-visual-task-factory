        "substeps_per_frame": {
          "title": "Substeps Per Frame",
          "type": "integer"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "displacement_m": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "object id -> distance between spawn and settled position, metres.",
          "title": "Displacement M",
          "type": "object"
        },
        "max_displacement_m": {
          "title": "Max Displacement M",
          "type": "number"
        },
        "off_table": {
          "description": "Objects whose settled centre left the table top.",
          "items": {
            "type": "string"
          },
          "title": "Off Table",
          "type": "array"
        }
