{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from vtf.core by `uv run python -m vtf.core.schemas`. Format version 0.1.0.",
  "$defs": {
    "CameraOutputs": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "title": "Camera Id",
          "type": "string"
        },
        "resolution": {
          "description": "Width, height in pixels.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
